# Next.js application only. No wallet private keys, ring passwords or model keys here.
AGENTGDP_DATA_DIR=data/app
APP_ORIGIN=http://127.0.0.1:3000
# Set true behind HTTPS in a public deployment.
COOKIE_SECURE=false
# Set long random independent values before a live/public deployment.
SESSION_SECRET=
OPERATOR_TOKEN=

BROKER_URL=http://127.0.0.1:4319
BROKER_TOKEN=
LEDGER_CONTROLLER_ADDRESS=
DATA_SERVICE_URL=http://127.0.0.1:4402
# Optional operator permission to change your own service's quoted prices for the demo.
DATA_SERVICE_OPERATOR_TOKEN=
