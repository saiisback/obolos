# Private broker configuration. Run under a separate OS account, outside the agent workspace.
# The app receives only BROKER_URL and the same BROKER_TOKEN, never this entire file.
BROKER_TOKEN=
BROKER_PORT=4319
BROKER_DATA_DIR=/absolute/private/obolos-broker-state
# Purchase principal caps across the complete journal, not per request or daily resets.
BROKER_MAX_DATA_ATOMIC=10000000
BROKER_MAX_USDC_ATOMIC=1000000
BROKER_ALLOWED_PROVIDERS=repo-standard,repo-economy

# Operator provisions this bundle through Ledger Key Ring. Inject WALLET_PASS at launch
# from the OS keychain; never put it in this file or give it to the model.
LEDGER_WALLET_CLI=/absolute/path/to/ethonline/node_modules/.bin/wallet-cli
LEDGER_RING_FILE=/absolute/private/obolos-secrets.enc
LEDGER_RING_KEY=obolos-broker
LEDGER_CONTROLLER_ADDRESS=
LEDGER_DERIVATION_PATH=44'/60'/0'/0/0

DATA_SERVICE_URL=http://127.0.0.1:4402
HEDERA_PAY_TO=

# Login happens manually under the broker account. The broker lists only agent wallets.
CIRCLE_CLI=/absolute/path/to/ethonline/node_modules/.bin/circle
CIRCLE_CLI_HOME=/absolute/private/circle-session
CIRCLE_WALLET_ADDRESS=
ARC_VERIFIER_ADDRESS=
ARC_RPC_URL=https://rpc.testnet.arc.network
# Fixed MVP contract: any other value disables/rejects verification.
ARC_VERIFICATION_FEE_ATOMIC=50000

# OpenAI-compatible HTTPS base ending in /v1; key is inside the encrypted bundle.
INFERENCE_BASE_URL=https://api.openai.com/v1
INFERENCE_MODEL=
