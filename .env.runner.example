# Public pins and private file locations for ONE user-owned agent runner.
# Copy to .env.runner with mode 0600. Replace every placeholder locally.
# npm run agent:runner loads .env.broker first, then .env.runner.
# Keep BROKER_TOKEN only in the private .env.broker; never put any raw token here.
RUNNER_PLATFORM_URL=https://obolos.app
RUNNER_AGENT_ID=YOUR_AGENT_UUID
RUNNER_OWNER_ADDRESS=YOUR_OWNER_EOA_ADDRESS

# Absolute paths only: env files do not expand ~ or $HOME.
# The raw one-time ob_runner_ token belongs in a private regular file with mode 0600.
# Its containing directory should be mode 0700 and owned by the runner OS user.
RUNNER_TOKEN_FILE=/absolute/private/my-agent/runner.token
# A durable, unique per-agent directory; never use BROKER_DATA_DIR or clone active state.
RUNNER_DATA_DIR=/absolute/private/my-agent/runner-state

# Match BROKER_PORT in .env.broker. The runner accepts only loopback HTTP brokers.
BROKER_URL=http://127.0.0.1:4319
# Set this SAME value in .env.broker; its example defaults to a local service.
DATA_SERVICE_URL=https://obolos.app/x402
# Set HEDERA_PAY_TO in .env.broker from the reviewed public /x402/quote response.
# See docs/runner-setup.md for your own Ring, Circle wallet and testnet funding setup.
