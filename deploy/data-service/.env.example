# Copy to .env.server on the VPS. Never commit the completed file.
# Use a hostname only, without https:// or a path.
DATA_SERVICE_DOMAIN=data.example.com
ACME_EMAIL=you@example.com
HEDERA_PAY_TO=0.0.10425234
# Use the existing DATA_SERVICE_OPERATOR_TOKEN from the local app's .env.local
# so the local planner can execute the authorized price-change demonstration.
DATA_SERVICE_OPERATOR_TOKEN=REPLACE_WITH_EXISTING_PRIVATE_OPERATOR_TOKEN
# Optional: a public-repository read-only GitHub token to raise API limits.
GITHUB_TOKEN=
