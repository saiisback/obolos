# Separate resource-service process. Never put the payer private key here.
DATA_SERVICE_HOST=127.0.0.1
DATA_SERVICE_PORT=4402
# Must exactly match the broker's DATA_SERVICE_URL; set HTTPS URL after deployment.
DATA_SERVICE_PUBLIC_URL=http://127.0.0.1:4402
DATA_SERVICE_DATA_DIR=data/data-service
# Numeric testnet recipient account, owned by the resource operator.
HEDERA_PAY_TO=
# At least 24 random characters; authenticates POST /operator/prices.
DATA_SERVICE_OPERATOR_TOKEN=
# Optional token scoped to public GitHub metadata; improves API rate allowance.
GITHUB_TOKEN=
